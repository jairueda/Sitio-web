<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Facebook per imparare l'Italiano</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --fb: #1877F2;
      --fb2: #145dbf;
      --ink: #111827;
      --muted: #6b7280;
      --bg: #f8faff;
      --white: #ffffff;
      --border: #e5e7eb;
      --green: #16a34a;
      --green-bg: #f0fdf4;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--ink); }

    /* NAV */
    nav {
      background: var(--white); border-bottom: 1px solid var(--border);
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(1rem, 5vw, 3rem); height: 58px;
    }
    .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .brand-icon { width: 32px; height: 32px; background: var(--fb); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
    .brand-icon svg { width: 18px; fill: white; }
    .brand-name { font-size: 1rem; font-weight: 600; color: var(--ink); }
    .brand-name span { color: var(--fb); }
    nav ul { list-style: none; display: flex; gap: 0; }
    nav ul li a {
      display: block; padding: .4rem 1rem;
      font-size: .88rem; font-weight: 500; color: var(--muted);
      text-decoration: none; border-radius: 6px; transition: .15s;
    }
    nav ul li a:hover { color: var(--fb); background: #eff6ff; }

    /* HERO */
    .hero {
      display: grid; grid-template-columns: 1fr 1fr; gap: 3rem;
      align-items: center; max-width: 1000px; margin: 0 auto;
      padding: 5rem clamp(1rem, 5vw, 2rem) 4rem;
    }
    .hero-eyebrow { display: flex; align-items: center; gap: 8px; margin-bottom: 1rem; }
    .pill { background: #dbeafe; color: var(--fb2); font-size: .75rem; font-weight: 600; padding: 3px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: .05em; }
    .hero h1 { font-family: 'DM Serif Display', serif; font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.1; margin-bottom: 1.1rem; }
    .hero h1 em { color: var(--fb); font-style: normal; }
    .hero p { color: var(--muted); font-size: 1rem; line-height: 1.75; margin-bottom: 1.8rem; }
    .cta-row { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn-primary { background: var(--fb); color: white; padding: .65rem 1.4rem; border-radius: 8px; font-weight: 600; font-size: .9rem; text-decoration: none; transition: .15s; }
    .btn-primary:hover { background: var(--fb2); }
    .btn-ghost { border: 1.5px solid var(--border); color: var(--ink); padding: .65rem 1.4rem; border-radius: 8px; font-weight: 600; font-size: .9rem; text-decoration: none; transition: .15s; }
    .btn-ghost:hover { border-color: var(--fb); color: var(--fb); }

    /* HERO MOCKUP */
    .phone-frame { background: var(--white); border: 2px solid var(--border); border-radius: 20px; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,.08); max-width: 280px; margin: 0 auto; }
    .phone-bar { background: var(--fb); padding: .5rem .75rem; display: flex; align-items: center; gap: 8px; }
    .phone-bar .fb-logo { font-size: .85rem; font-weight: 700; color: white; }
    .phone-bar .searchbar { flex: 1; background: rgba(255,255,255,.2); border-radius: 20px; padding: 4px 10px; font-size: .75rem; color: rgba(255,255,255,.8); }
    .post { padding: .75rem; border-bottom: 1px solid var(--border); }
    .post-header { display: flex; align-items: center; gap: 8px; margin-bottom: .5rem; }
    .avatar { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .75rem; font-weight: 600; flex-shrink: 0; }
    .post-meta { font-size: .72rem; }
    .post-meta strong { display: block; color: var(--ink); font-size: .78rem; }
    .post-meta span { color: var(--muted); }
    .post-text { font-size: .78rem; line-height: 1.6; color: var(--ink); margin-bottom: .5rem; }
    .post-text .highlight { background: #dbeafe; color: var(--fb2); border-radius: 3px; padding: 0 3px; font-weight: 500; }
    .post-reactions { display: flex; gap: 12px; font-size: .72rem; color: var(--muted); }
    .reaction { display: flex; align-items: center; gap: 3px; }

    /* SECTIONS */
    section { padding: 4rem clamp(1rem, 5vw, 2rem); }
    .section-wrap { max-width: 1000px; margin: 0 auto; }
    .section-label { font-size: .75rem; font-weight: 600; color: var(--fb); text-transform: uppercase; letter-spacing: .08em; margin-bottom: .4rem; }
    .section-title { font-family: 'DM Serif Display', serif; font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: .7rem; }
    .section-sub { color: var(--muted); font-size: .98rem; line-height: 1.7; max-width: 580px; margin-bottom: 2rem; }
    section:nth-child(even) { background: var(--white); }

    /* CARDS */
    .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.2rem; }
    .card { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 1.4rem; transition: box-shadow .2s; }
    .card:hover { box-shadow: 0 4px 18px rgba(24,119,242,.1); }
    .card-num { font-family: 'DM Serif Display', serif; font-size: 2rem; color: #dbeafe; line-height: 1; margin-bottom: .4rem; }
    .card h3 { font-size: .95rem; font-weight: 600; margin-bottom: .4rem; }
    .card p { font-size: .85rem; color: var(--muted); line-height: 1.6; }

    /* EXAMPLE POST (grande) */
    .example-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
    .example-label { font-size: .72rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: .6rem; }
    .fb-post-card { background: var(--white); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
    .fb-post-card .fb-header { background: var(--fb); padding: .5rem .85rem; display: flex; align-items: center; gap: 8px; }
    .fb-post-card .fb-header span { color: white; font-size: .8rem; font-weight: 600; }
    .fb-post-card .fb-header .dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.5); }
    .fb-post-card .post-body { padding: 1rem; }
    .fb-post-card .post-body .author { display: flex; align-items: center; gap: 10px; margin-bottom: .7rem; }
    .fb-post-card .post-body .author-info strong { font-size: .9rem; color: var(--ink); }
    .fb-post-card .post-body .author-info span { font-size: .78rem; color: var(--muted); display: block; }
    .fb-post-card .post-body .text { font-size: .88rem; line-height: 1.7; color: var(--ink); }
    .fb-post-card .post-body .text .word { display: inline-block; background: #fffbeb; border: 1px solid #fcd34d; color: #92400e; border-radius: 4px; padding: 0 5px; font-weight: 500; cursor: default; }
    .fb-post-card .post-body .text .word:hover::after { content: attr(data-tr); position: absolute; background: var(--ink); color: white; font-size: .75rem; padding: 3px 7px; border-radius: 5px; margin-top: -28px; white-space: nowrap; }
    .fb-post-card .post-body .text .word { position: relative; }
    .post-footer { border-top: 1px solid var(--border); padding: .6rem 1rem; display: flex; gap: 1.5rem; font-size: .82rem; color: var(--muted); }
    .post-footer span { cursor: pointer; }
    .post-footer span:hover { color: var(--fb); }
    .annotation-box { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 1.2rem; }
    .annotation-box h4 { font-size: .9rem; font-weight: 600; margin-bottom: .9rem; color: var(--ink); }
    .anno-item { display: flex; gap: 10px; margin-bottom: .8rem; align-items: flex-start; }
    .anno-badge { background: #fffbeb; border: 1px solid #fcd34d; color: #92400e; font-size: .75rem; font-weight: 600; padding: 2px 8px; border-radius: 4px; white-space: nowrap; flex-shrink: 0; }
    .anno-text { font-size: .83rem; color: var(--ink); line-height: 1.55; }
    .anno-text em { color: var(--muted); font-style: normal; font-size: .8rem; }

    /* RISORSE */
    .resources-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
    .res-card { background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 1.1rem 1.2rem; display: flex; gap: 14px; align-items: flex-start; }
    .res-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
    .res-info h4 { font-size: .9rem; font-weight: 600; margin-bottom: .2rem; }
    .res-info p { font-size: .8rem; color: var(--muted); line-height: 1.5; }
    .res-tag { display: inline-block; font-size: .7rem; font-weight: 600; padding: 2px 8px; border-radius: 10px; margin-top: .4rem; }

    /* ACTIVITY */
    .steps { counter-reset: step; }
    .step { display: flex; gap: 1.2rem; margin-bottom: 1.4rem; align-items: flex-start; }
    .step-num { counter-increment: step; min-width: 36px; height: 36px; background: var(--fb); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: .88rem; flex-shrink: 0; }
    .step-content h4 { font-size: .93rem; font-weight: 600; margin-bottom: .25rem; }
    .step-content p { font-size: .85rem; color: var(--muted); line-height: 1.6; }
    .tip-box { background: var(--green-bg); border-left: 4px solid var(--green); border-radius: 0 10px 10px 0; padding: 1rem 1.2rem; margin-top: 1.5rem; }
    .tip-box p { font-size: .88rem; color: #166534; line-height: 1.65; }

    /* FOOTER */
    footer { background: var(--ink); color: #9ca3af; text-align: center; padding: 1.6rem 1rem; font-size: .83rem; }
    footer strong { color: var(--fb); }

    @media(max-width: 640px) {
      .hero, .example-grid { grid-template-columns: 1fr; }
      .phone-frame { display: none; }
      nav ul li a { padding: .4rem .6rem; }
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <a class="brand" href="#home">
    <div class="brand-icon">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
      </svg>
    </div>
    <span class="brand-name">Italiano <span>con Facebook</span></span>
  </a>
  <ul>
    <li><a href="#perche">Perché funziona</a></li>
    <li><a href="#esempio">Esempio reale</a></li>
    <li><a href="#attivita">Attività</a></li>
  </ul>
</nav>

<!-- HERO -->
<div id="home" style="background: var(--white); border-bottom: 1px solid var(--border);">
  <div class="hero">
    <div>
      <div class="hero-eyebrow"><span class="pill">🇮🇹 Lingua &amp; Social Media</span></div>
      <h1>Impara l'italiano <em>scorrendo</em> il feed</h1>
      <p>Facebook non è solo per i nonni — è una finestra su milioni di italiani che scrivono, discutono e condividono ogni giorno. Lingua autentica, gratis, sempre a portata di mano.</p>
      <div class="cta-row">
        <a class="btn-primary" href="#esempio">Vedi un esempio reale</a>
        <a class="btn-ghost" href="#attivita">Vai all'attività</a>
      </div>
    </div>
    <!-- Mockup telefono -->
    <div class="phone-frame">
      <div class="phone-bar">
        <span class="fb-logo">f</span>
        <span class="searchbar">Cerca su Facebook...</span>
      </div>
      <div class="post">
        <div class="post-header">
          <div class="avatar" style="background:#dbeafe; color:#1e40af;">GR</div>
          <div class="post-meta"><strong>Gruppo: Italiano per tutti</strong><span>2 ore fa</span></div>
        </div>
        <p class="post-text">Ciao a tutti! Oggi ho imparato la parola <span class="highlight">"spuntino"</span> — significa un piccolo pasto tra pranzo e cena. Voi fate lo spuntino? 🍎</p>
        <div class="post-reactions"><span class="reaction">👍 47</span><span class="reaction">💬 23 commenti</span></div>
      </div>
      <div class="post">
        <div class="post-header">
          <div class="avatar" style="background:#dcfce7; color:#166534;">MM</div>
          <div class="post-meta"><strong>Marco Mancini</strong><span>ieri</span></div>
        </div>
        <p class="post-text">Chi sa qual è la differenza tra <span class="highlight">"allora"</span> e <span class="highlight">"quindi"</span>? 🤔</p>
        <div class="post-reactions"><span class="reaction">❤️ 31</span><span class="reaction">💬 58 commenti</span></div>
      </div>
      <div class="post" style="border:none;">
        <div class="post-header">
          <div class="avatar" style="background:#fef9c3; color:#854d0e;">LC</div>
          <div class="post-meta"><strong>Lezioni di Cultura IT</strong><span>3 giorni fa</span></div>
        </div>
        <p class="post-text">🎬 Video: "Come ordinare al bar in Italia" — Guarda e impara le frasi essenziali!</p>
        <div class="post-reactions"><span class="reaction">▶️ 1.2k visualizzazioni</span></div>
      </div>
    </div>
  </div>
</div>

<!-- SEZIONE 1: PERCHÉ FUNZIONA -->
<section id="perche">
  <div class="section-wrap">
    <p class="section-label">Sezione 1 — Perché funziona</p>
    <h2 class="section-title">Facebook come palestra linguistica</h2>
    <p class="section-sub">Ogni volta che apri Facebook, sei circondato da testo in italiano reale. Ecco perché è uno strumento così potente per imparare.</p>
    <div class="grid3">
      <div class="card">
        <div class="card-num">01</div>
        <h3>Lingua viva, non di libro</h3>
        <p>I post usano lo stesso italiano che parlano le persone: espressioni colloquiali, abbreviazioni, umorismo.</p>
      </div>
      <div class="card">
        <div class="card-num">02</div>
        <h3>Input comprensibile</h3>
        <p>I post brevi con immagini ti danno contesto visivo — capisci il significato anche senza conoscere ogni parola.</p>
      </div>
      <div class="card">
        <div class="card-num">03</div>
        <h3>Interazione reale</h3>
        <p>Puoi commentare, fare domande e ricevere risposte da madrelingua. Nessun manuale lo può sostituire.</p>
      </div>
      <div class="card">
        <div class="card-num">04</div>
        <h3>Varietà di registri</h3>
        <p>Trovi italiano formale (pagine di notizie), informale (gruppi di amici) e gergale (meme). Tutti utili!</p>
      </div>
    </div>
  </div>
</section>

<!-- SEZIONE 2: ESEMPIO REALE -->
<section id="esempio">
  <div class="section-wrap">
    <p class="section-label">Sezione 2 — Esempio reale</p>
    <h2 class="section-title">Come leggere un post in italiano</h2>
    <p class="section-sub">Vediamo insieme un post autentico di un gruppo Facebook e come puoi usarlo per imparare vocabolario e grammatica.</p>

    <div class="example-grid">
      <div>
        <p class="example-label">Post originale (gruppo "Impara l'Italiano")</p>
        <div class="fb-post-card">
          <div class="fb-header">
            <span>Impara l'Italiano 🇮🇹</span>
            <div class="dot"></div>
            <span style="opacity:.7">gruppo pubblico</span>
          </div>
          <div class="post-body">
            <div class="author">
              <div class="avatar" style="background:#dbeafe; color:#1e40af; width:38px; height:38px;">SF</div>
              <div class="author-info">
                <strong>Sara Ferretti</strong>
                <span>5 ore fa · 🌐 Pubblico</span>
              </div>
            </div>
            <p class="text">
              Ciao a tutti! Oggi vi
              <span class="word" data-tr="condivido">condivido</span>
              una cosa interessante: in italiano, quando sei molto
              <span class="word" data-tr="stanco/a">stanco</span>,
              puoi dire "sono
              <span class="word" data-tr="distrutto/a = exhausted">distrutto</span>"
              oppure "sono
              <span class="word" data-tr="a pezzi = in pieces (exhausted)">a pezzi</span>"
              😄<br><br>
              Queste
              <span class="word" data-tr="espressioni idiomatiche">espressioni</span>
              si usano
              <span class="word" data-tr="tantissimo = very often">tantissimo</span>
              nella vita quotidiana! Voi conoscete altre espressioni simili? Scrivetele
              <span class="word" data-tr="qui sotto = below">qui sotto</span>
              nei commenti! 👇
            </p>
          </div>
          <div class="post-footer">
            <span>👍 Mi piace</span>
            <span>💬 Commenta</span>
            <span>↗ Condividi</span>
          </div>
        </div>
      </div>

      <div>
        <p class="example-label">Analisi linguistica del post</p>
        <div class="annotation-box">
          <h4>📌 Parole e strutture chiave</h4>
          <div class="anno-item">
            <span class="anno-badge">condivido</span>
            <p class="anno-text">Dal verbo <strong>condividere</strong> (to share) — prima persona singolare, presente. <em>= I share with you</em></p>
          </div>
          <div class="anno-item">
            <span class="anno-badge">distrutto/a</span>
            <p class="anno-text">Letteralmente "destroyed" — usato per dire di essere esausti. <em>= completamente stanco</em></p>
          </div>
          <div class="anno-item">
            <span class="anno-badge">a pezzi</span>
            <p class="anno-text">Espressione idiomatica: "in pieces". <em>= esausto, a pezzi</em></p>
          </div>
          <div class="anno-item">
            <span class="anno-badge">tantissimo</span>
            <p class="anno-text">Superlativo di <strong>tanto</strong> — enfatizza la frequenza. <em>= very, very much</em></p>
          </div>
          <div class="anno-item">
            <span class="anno-badge">qui sotto</span>
            <p class="anno-text">Espressione di luogo: "down here / below". <em>Usata moltissimo nei social!</em></p>
          </div>
        </div>

        <div style="margin-top:1rem; background:#f0f9ff; border:1px solid #bae6fd; border-radius:10px; padding:1rem;">
          <p style="font-size:.82rem; color:#0c4a6e; line-height:1.65;">
            <strong>💡 Strategia:</strong> Copia le espressioni che non conosci in un quaderno digitale. Poi cerca esempi su Facebook di come le usano in altri post. Il contesto è tutto!
          </p>
        </div>
      </div>
    </div>

    <!-- Gruppi consigliati -->
    <div style="margin-top:3rem;">
      <h3 style="font-family:'DM Serif Display',serif; font-size:1.3rem; margin-bottom:1.2rem;">Gruppi e pagine Facebook consigliati</h3>
      <div class="resources-list">
        <div class="res-card">
          <div class="res-icon" style="background:#dbeafe;">👥</div>
          <div class="res-info">
            <h4>Impara l'Italiano</h4>
            <p>Vocabolario quotidiano, espressioni idiomatiche, domande e risposte con madrelingua.</p>
            <span class="res-tag" style="background:#dbeafe; color:#1e40af;">Gruppo</span>
          </div>
        </div>
        <div class="res-card">
          <div class="res-icon" style="background:#dcfce7;">📰</div>
          <div class="res-info">
            <h4>RAI News</h4>
            <p>Video di notizie in italiano standard e chiaro — ottimo per allenare l'ascolto.</p>
            <span class="res-tag" style="background:#dcfce7; color:#166534;">Pagina</span>
          </div>
        </div>
        <div class="res-card">
          <div class="res-icon" style="background:#fef9c3;">🎓</div>
          <div class="res-info">
            <h4>ItalianPod101</h4>
            <p>Lezioni brevi, quiz di vocabolario, video con sottotitoli in italiano e inglese.</p>
            <span class="res-tag" style="background:#fef9c3; color:#854d0e;">Pagina</span>
          </div>
        </div>
        <div class="res-card">
          <div class="res-icon" style="background:#fce7f3;">🏛️</div>
          <div class="res-info">
            <h4>Accademia della Crusca</h4>
            <p>L'istituto ufficiale della lingua italiana — curiosità sulla storia delle parole.</p>
            <span class="res-tag" style="background:#fce7f3; color:#9d174d;">Pagina</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SEZIONE 3: ATTIVITÀ -->
<section id="attivita">
  <div class="section-wrap">
    <p class="section-label">Sezione 3 — Attività pratiche</p>
    <h2 class="section-title">Due attività per imparare davvero</h2>
    <p class="section-sub">Una sfida da fare su Facebook, e un quiz interattivo qui nel sito. Fai entrambe!</p>

    <!-- ATTIVITÀ A -->
    <div style="background:var(--white); border:1px solid var(--border); border-radius:16px; overflow:hidden; margin-bottom:2rem;">
      <div style="background:var(--fb); padding:1rem 1.5rem; display:flex; align-items:center; gap:12px;">
        <span style="background:white; color:var(--fb); font-weight:700; font-size:.8rem; padding:3px 10px; border-radius:20px;">ATTIVITÀ A</span>
        <h3 style="color:white; font-size:1rem; font-weight:600;">Facebook in italiano — La sfida dell'immersione</h3>
      </div>
      <div style="padding:1.5rem; display:grid; grid-template-columns:1fr 1fr; gap:2rem; align-items:start;">
        <div>
          <p style="font-size:.9rem; color:var(--muted); margin-bottom:1.2rem; line-height:1.7;">Cambia la lingua di Facebook in italiano per almeno <strong>3 giorni</strong>. Ogni pulsante, notifica e menu diventa un esercizio passivo. Segui questi passi:</p>
          <div class="steps">
            <div class="step">
              <div class="step-num">1</div>
              <div class="step-content">
                <h4>Cambia la lingua</h4>
                <p>Impostazioni → Lingua → Italiano. Da questo momento, "Mi piace", "Condividi" e "Commenta" sono le tue nuove parole.</p>
              </div>
            </div>
            <div class="step">
              <div class="step-num">2</div>
              <div class="step-content">
                <h4>Esplora tutto</h4>
                <p>Vai in ogni sezione: Notizie, Gruppi, Marketplace, Storie. Annota 5 parole nuove che trovi nell'interfaccia.</p>
              </div>
            </div>
            <div class="step">
              <div class="step-num">3</div>
              <div class="step-content">
                <h4>Leggi senza dizionario</h4>
                <p>Scegli 3 post in italiano e leggili cercando di capire il senso generale. Poi verifica con il dizionario.</p>
              </div>
            </div>
            <div class="step">
              <div class="step-num">4</div>
              <div class="step-content">
                <h4>Scrivi un commento</h4>
                <p>In un gruppo italiano, scrivi almeno un commento in italiano. Può essere breve — l'importante è farlo!</p>
              </div>
            </div>
          </div>
          <div class="tip-box" style="margin-top:1rem;">
            <p>📱 <strong>Consiglio:</strong> Fai uno screenshot delle parole dell'interfaccia che non conosci e cercale. "Notizie" = News, "Storie" = Stories, "Amici" = Friends!</p>
          </div>
        </div>
        <div>
          <p style="font-size:.78rem; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; margin-bottom:.7rem;">Come appare Facebook in italiano</p>
          <div style="border:1px solid var(--border); border-radius:12px; overflow:hidden;">
            <div style="background:#1877F2; padding:.5rem .85rem; display:flex; gap:10px; align-items:center;">
              <span style="color:white; font-weight:700; font-size:1rem;">f</span>
              <div style="flex:1; background:rgba(255,255,255,.2); border-radius:20px; padding:3px 10px; font-size:.75rem; color:rgba(255,255,255,.8);">🔍 Cerca su Facebook</div>
            </div>
            <div style="background:#f0f2f5; padding:.5rem .75rem; display:flex; gap:1rem; border-bottom:1px solid var(--border); overflow:hidden;">
              <span style="font-size:.75rem; font-weight:600; color:var(--fb); border-bottom:2px solid var(--fb); padding-bottom:4px;">Notizie</span>
              <span style="font-size:.75rem; color:var(--muted);">Amici</span>
              <span style="font-size:.75rem; color:var(--muted);">Gruppi</span>
              <span style="font-size:.75rem; color:var(--muted);">Video</span>
            </div>
            <div style="padding:.85rem; background:white;">
              <div style="display:flex; align-items:center; gap:8px; margin-bottom:.7rem;">
                <div class="avatar" style="background:#dbeafe; color:#1e40af; width:34px; height:34px; font-size:.75rem;">TU</div>
                <div style="flex:1; background:#f0f2f5; border-radius:20px; padding:.45rem 1rem; font-size:.8rem; color:var(--muted);">A cosa stai pensando?</div>
              </div>
              <div style="display:flex; gap:0; border-top:1px solid var(--border); padding-top:.6rem;">
                <div style="flex:1; text-align:center; font-size:.75rem; color:var(--muted); padding:.3rem;">📹 Video in diretta</div>
                <div style="flex:1; text-align:center; font-size:.75rem; color:var(--muted); padding:.3rem;">🖼️ Foto/video</div>
                <div style="flex:1; text-align:center; font-size:.75rem; color:var(--muted); padding:.3rem;">😊 Stato</div>
              </div>
            </div>
            <div style="padding:.7rem .85rem; background:white; border-top:1px solid var(--border);">
              <div style="display:flex; gap:8px; align-items:flex-start;">
                <div class="avatar" style="background:#dcfce7; color:#166534; width:30px; height:30px; font-size:.7rem; flex-shrink:0;">MR</div>
                <div>
                  <p style="font-size:.78rem;"><strong>Marco Rossi</strong> ha condiviso un ricordo.</p>
                  <p style="font-size:.72rem; color:var(--muted);">2 ore fa · 🌐</p>
                  <div style="margin-top:.4rem; display:flex; gap:1rem;">
                    <span style="font-size:.75rem; color:var(--muted);">👍 Mi piace</span>
                    <span style="font-size:.75rem; color:var(--muted);">💬 Commenta</span>
                    <span style="font-size:.75rem; color:var(--muted);">↗ Condividi</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div style="margin-top:.8rem; background:#fffbeb; border:1px solid #fcd34d; border-radius:10px; padding:.8rem 1rem;">
            <p style="font-size:.8rem; color:#92400e; line-height:1.6;"><strong>🔑 Vocabolario interfaccia:</strong> Mi piace = Like · Condividi = Share · Commenta = Comment · Notizie = Feed · Amici suggeriti = Suggested friends · Storie = Stories</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ATTIVITÀ B: QUIZ INTERATTIVO -->
    <div style="background:var(--white); border:1px solid var(--border); border-radius:16px; overflow:hidden;">
      <div style="background:var(--green); padding:1rem 1.5rem; display:flex; align-items:center; gap:12px;">
        <span style="background:white; color:var(--green); font-weight:700; font-size:.8rem; padding:3px 10px; border-radius:20px;">ATTIVITÀ B</span>
        <h3 style="color:white; font-size:1rem; font-weight:600;">Quiz interattivo — Conosci l'italiano dei social?</h3>
      </div>
      <div style="padding:1.5rem;">
        <p style="font-size:.9rem; color:var(--muted); margin-bottom:1.5rem; line-height:1.7;">Tutte le frasi qui sotto vengono da post reali di Facebook. Abbina ogni espressione italiana alla sua traduzione corretta. Clicca sulla risposta giusta!</p>

        <div id="quiz">
          <!-- Q1 -->
          <div class="q-block" id="q1" style="margin-bottom:1.4rem;">
            <p style="font-size:.93rem; font-weight:600; margin-bottom:.7rem; color:var(--ink);">1. Qualcuno commenta su un video divertente: <em style="color:var(--fb);">"Sto morendo dalle risate 😂"</em> — Cosa significa?</p>
            <div class="opts" style="display:flex; flex-wrap:wrap; gap:.5rem;">
              <button class="opt" data-q="1" data-correct="false" onclick="checkAnswer(this)">I'm dying of sadness</button>
              <button class="opt" data-q="1" data-correct="true" onclick="checkAnswer(this)">I'm dying of laughter</button>
              <button class="opt" data-q="1" data-correct="false" onclick="checkAnswer(this)">I'm watching a funny video</button>
            </div>
            <p class="q-fb" id="fb1" style="display:none; font-size:.83rem; margin-top:.5rem; padding:.5rem .8rem; border-radius:8px;"></p>
          </div>
          <!-- Q2 -->
          <div class="q-block" id="q2" style="margin-bottom:1.4rem;">
            <p style="font-size:.93rem; font-weight:600; margin-bottom:.7rem; color:var(--ink);">2. In un gruppo di cucina leggono: <em style="color:var(--fb);">"Che buono! Lo provo subito!"</em> — Cosa stanno per fare?</p>
            <div class="opts" style="display:flex; flex-wrap:wrap; gap:.5rem;">
              <button class="opt" data-q="2" data-correct="false" onclick="checkAnswer(this)">They are going to buy it</button>
              <button class="opt" data-q="2" data-correct="false" onclick="checkAnswer(this)">They already tried it</button>
              <button class="opt" data-q="2" data-correct="true" onclick="checkAnswer(this)">They are going to try it right now</button>
            </div>
            <p class="q-fb" id="fb2" style="display:none; font-size:.83rem; margin-top:.5rem; padding:.5rem .8rem; border-radius:8px;"></p>
          </div>
          <!-- Q3 -->
          <div class="q-block" id="q3" style="margin-bottom:1.4rem;">
            <p style="font-size:.93rem; font-weight:600; margin-bottom:.7rem; color:var(--ink);">3. Qualcuno posta una foto e scrive: <em style="color:var(--fb);">"Finalmente le vacanze! Sono stanco morto."</em> — Come si sente?</p>
            <div class="opts" style="display:flex; flex-wrap:wrap; gap:.5rem;">
              <button class="opt" data-q="3" data-correct="false" onclick="checkAnswer(this)">He is bored on vacation</button>
              <button class="opt" data-q="3" data-correct="true" onclick="checkAnswer(this)">He is exhausted but happy it's vacation</button>
              <button class="opt" data-q="3" data-correct="false" onclick="checkAnswer(this)">He is sick and can't travel</button>
            </div>
            <p class="q-fb" id="fb3" style="display:none; font-size:.83rem; margin-top:.5rem; padding:.5rem .8rem; border-radius:8px;"></p>
          </div>
          <!-- Q4 -->
          <div class="q-block" id="q4" style="margin-bottom:1.4rem;">
            <p style="font-size:.93rem; font-weight:600; margin-bottom:.7rem; color:var(--ink);">4. In un gruppo di lingua: <em style="color:var(--fb);">"Non ci credo! Che bella notizia! 🎉"</em> — Qual è l'emozione?</p>
            <div class="opts" style="display:flex; flex-wrap:wrap; gap:.5rem;">
              <button class="opt" data-q="4" data-correct="false" onclick="checkAnswer(this)">Sadness and disbelief</button>
              <button class="opt" data-q="4" data-correct="false" onclick="checkAnswer(this)">Anger and surprise</button>
              <button class="opt" data-q="4" data-correct="true" onclick="checkAnswer(this)">Positive surprise and joy</button>
            </div>
            <p class="q-fb" id="fb4" style="display:none; font-size:.83rem; margin-top:.5rem; padding:.5rem .8rem; border-radius:8px;"></p>
          </div>
          <!-- Q5 -->
          <div class="q-block" id="q5" style="margin-bottom:1.8rem;">
            <p style="font-size:.93rem; font-weight:600; margin-bottom:.7rem; color:var(--ink);">5. Un post dice: <em style="color:var(--fb);">"Dai, scrivetemi nei commenti qui sotto! Vi aspetto!"</em> — Cosa vuole il poster?</p>
            <div class="opts" style="display:flex; flex-wrap:wrap; gap:.5rem;">
              <button class="opt" data-q="5" data-correct="true" onclick="checkAnswer(this)">Wants people to comment below</button>
              <button class="opt" data-q="5" data-correct="false" onclick="checkAnswer(this)">Wants people to share the post</button>
              <button class="opt" data-q="5" data-correct="false" onclick="checkAnswer(this)">Wants people to send a message</button>
            </div>
            <p class="q-fb" id="fb5" style="display:none; font-size:.83rem; margin-top:.5rem; padding:.5rem .8rem; border-radius:8px;"></p>
          </div>

          <div id="score-box" style="display:none; background:#f0fdf4; border:1.5px solid #86efac; border-radius:12px; padding:1.2rem 1.5rem; text-align:center;">
            <p id="score-text" style="font-size:1rem; font-weight:600; color:#166534; margin-bottom:.3rem;"></p>
            <p id="score-sub" style="font-size:.85rem; color:#15803d;"></p>
            <button onclick="resetQuiz()" style="margin-top:.8rem; background:var(--green); color:white; border:none; padding:.5rem 1.3rem; border-radius:8px; font-size:.85rem; font-weight:600; cursor:pointer;">🔄 Riprova</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .opt {
    background: var(--bg); border: 1.5px solid var(--border);
    padding: .5rem 1rem; border-radius: 8px; font-size: .85rem;
    cursor: pointer; font-family: 'DM Sans', sans-serif; color: var(--ink);
    transition: .15s;
  }
  .opt:hover:not(:disabled) { border-color: var(--fb); color: var(--fb); background: #eff6ff; }
  .opt.correct { background: #f0fdf4; border-color: #16a34a; color: #166534; font-weight: 600; }
  .opt.wrong { background: #fef2f2; border-color: #ef4444; color: #991b1b; }
  .opt:disabled { cursor: default; opacity: .85; }
</style>

<script>
  const explanations = {
    1: { ok: "✅ Esatto! \"Morire dalle risate\" è un'espressione idiomatica = to laugh so hard you could die. Usatissima sui social!", no: "❌ \"Risate\" viene da ridere (to laugh). \"Sto morendo dalle risate\" = I'm dying of laughter." },
    2: { ok: "✅ Bravissimo! \"Lo provo subito\" = I'll try it right now. \"Subito\" è una parola chiave: significa immediatamente!", no: "❌ \"Provo\" viene da provare (to try). \"Subito\" = right now/immediately. Quindi stanno per provare la ricetta!" },
    3: { ok: "✅ Perfetto! \"Stanco morto\" = dead tired (exhausted). È un'espressione iperbole molto comune in italiano.", no: "❌ \"Stanco morto\" = dead tired. \"Finalmente\" = finally/at last — quindi è sollievo, non noia o malattia!" },
    4: { ok: "✅ Corretto! \"Non ci credo!\" può essere sorpresa positiva, e con 🎉 è chiaramente gioia. \"Che bella notizia!\" = What great news!", no: "❌ \"Non ci credo\" letteralmente = I can't believe it, ma con 🎉 è sorpresa positiva! \"Bella notizia\" = good news." },
    5: { ok: "✅ Ottimo! \"Scrivetemi nei commenti qui sotto\" = write to me in the comments below. \"Vi aspetto\" = I'm waiting for you!", no: "❌ \"Scrivetemi\" = write to me (voi → vi). \"Qui sotto\" = below/down here. Vuole commenti, non condivisioni o messaggi!" }
  };
  let answered = {};

  function checkAnswer(btn) {
    const q = btn.dataset.q;
    if (answered[q]) return;
    answered[q] = true;
    const correct = btn.dataset.correct === 'true';
    const block = document.getElementById('q' + q);
    block.querySelectorAll('.opt').forEach(b => {
      b.disabled = true;
      if (b.dataset.correct === 'true') b.classList.add('correct');
    });
    if (!correct) btn.classList.add('wrong');
    const fb = document.getElementById('fb' + q);
    fb.style.display = 'block';
    fb.textContent = correct ? explanations[q].ok : explanations[q].no;
    fb.style.background = correct ? '#f0fdf4' : '#fef2f2';
    fb.style.color = correct ? '#166534' : '#991b1b';
    if (Object.keys(answered).length === 5) showScore();
  }

  function showScore() {
    const correct = Object.keys(answered).filter(q =>
      document.querySelector(`.opt[data-q="${q}"].correct`) &&
      !document.querySelector(`.opt[data-q="${q}"].wrong`)
    ).length;
    const box = document.getElementById('score-box');
    const msgs = ['Continua a praticare! 💪', 'Buon inizio! 🙂', 'Non male! 👍', 'Bravissimo! ⭐', 'Quasi perfetto! 🌟', 'Perfetto! Sei un campione! 🏆'];
    document.getElementById('score-text').textContent = `Hai risposto correttamente a ${correct} domande su 5!`;
    document.getElementById('score-sub').textContent = msgs[correct];
    box.style.display = 'block';
    box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function resetQuiz() {
    answered = {};
    document.querySelectorAll('.opt').forEach(b => {
      b.disabled = false;
      b.classList.remove('correct', 'wrong');
    });
    document.querySelectorAll('.q-fb').forEach(el => el.style.display = 'none');
    document.getElementById('score-box').style.display = 'none';
  }
</script>

